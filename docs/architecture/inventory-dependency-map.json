  "cards": [
    {
      "dot": "emerald",
      "title": "Authoritative Sync Contract",
      "items": [
        "Zero direct database writes: all client status changes routed through /api/staff/update-order-status",
        "Offline queue stores idempotency keys: kds_batch_${batchId}_${nextStatus}_${timestamp}",
        "Automatic queue drainage triggered by window online event and component mount"
