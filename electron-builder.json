{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.cleverops.smartdine",
  "productName": "SmartDine",
  "directories": {
    "app": "electron",
    "output": "dist-desktop"
  },
  "files": [
    "**/*"
  ],
  "extraResources": [
    {
      "from": "public",
      "to": "public",
      "filter": ["icon.png", "favicon.ico", "favicon-32x32.png"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SmartDine POS"
  },
  "portable": {
    "splashImage": "public/icon.png"
  }
}
