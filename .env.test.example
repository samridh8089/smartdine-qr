# SmartDine E2E Test Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.test and fill in your test Supabase project credentials.
# NEVER use production credentials here.
#
# This file is read by the Playwright test suite.
# It is NOT read by the Next.js application.
#
# Usage:
#   Copy: cp .env.test.example .env.test
#   Then fill in the values below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Next.js App URL ───────────────────────────────────────────────────────
# The URL Playwright will open for tests.
# Default: http://localhost:3000 (matches `npm run dev`)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ── Supabase Test Project ─────────────────────────────────────────────────
# Use a DEDICATED test Supabase project — never point at production.
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key

# ── Supabase Service Role Key ─────────────────────────────────────────────
# Used by global-teardown.ts and test data helpers to delete ephemeral data.
# This key bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# ── Test Seed User Credentials (Spec TDM-002) ─────────────────────────────
# These must match users in your test Supabase project.
E2E_OWNER_EMAIL=owner@test.com
E2E_OWNER_PASSWORD=TestOwner123!

E2E_WAITER_EMAIL=waiter@test.com
E2E_WAITER_PASSWORD=TestWaiter123!

E2E_KITCHEN_EMAIL=kitchen@test.com
E2E_KITCHEN_PASSWORD=TestKitchen123!

E2E_CASHIER_EMAIL=cashier@test.com
E2E_CASHIER_PASSWORD=TestCashier123!

E2E_MANAGER_EMAIL=manager@test.com
E2E_MANAGER_PASSWORD=TestManager123!

E2E_SUPER_ADMIN_EMAIL=superadmin@test.com
E2E_SUPER_ADMIN_PASSWORD=SuperAdmin123!

# ── Test Restaurant ────────────────────────────────────────────────────────
E2E_RESTAURANT_SLUG=test-restaurant
E2E_TABLE_SLUG=table-1
