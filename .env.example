# Supabase Connection Keys
# Copy this file to .env.local and fill in your Supabase project credentials.
# Leave them empty to automatically run in Local Mock Mode (using localStorage).

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=https://www.cleverops.in

# Server Secrets & Payment Keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=your-resend-api-key
MSG91_API_KEY=your-msg91-api-key


# Rate Limiting Configuration
RATE_LIMIT_LOGIN_PER_IP=5
RATE_LIMIT_LOGIN_PER_ACCOUNT=3
RATE_LIMIT_AUTH_PER_IP=10
RATE_LIMIT_AUTH_PER_ACCOUNT=5
RATE_LIMIT_PUBLIC_PER_IP=60
RATE_LIMIT_AUTHENTICATED_PER_IP=120
RATE_LIMIT_BACKOFF_BASE=2
RATE_LIMIT_BACKOFF_MAX=3600
RATE_LIMIT_WINDOW_MS=60000

